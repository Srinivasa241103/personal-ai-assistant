{
  "name": "myra-server",
  "version": "1.0.0",
  "description": "Backend for the myra (AI personal assistant)",
  "license": "ISC",
  "author": "srinivasa",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:baseline": "tsc -p tsconfig.test.json",
    "typecheck:v2": "tsc -p tsconfig.v2.json",
    "services:up": "docker compose -f ../docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f ../docker-compose.dev.yml down",
    "services:reset": "docker compose -f ../docker-compose.dev.yml down --volumes --remove-orphans && docker compose -f ../docker-compose.dev.yml up -d --wait",
    "services:logs": "docker compose -f ../docker-compose.dev.yml logs --follow --tail=100",
    "services:status": "docker compose -f ../docker-compose.dev.yml ps",
    "migrate": "tsx scripts/migrateDatabase.ts",
    "migrate:chroma": "tsx scripts/migratePgvectorToChroma.ts",
    "migrate:chroma:dry-run": "tsx scripts/migratePgvectorToChroma.ts --dry-run",
    "reconcile:indexes": "tsx scripts/reconcileRetrievalIndexes.ts",
    "reconcile:indexes:dry-run": "tsx scripts/reconcileRetrievalIndexes.ts --dry-run",
    "test:fnd-01": "node --import tsx test/test-fnd01-flow-contracts.ts",
    "test:fnd-04": "node --import tsx --test test/foundation/authTenantIsolation.test.ts",
    "test:fnd-05.3": "node --import tsx --test test/foundation/redisClient.unit.test.ts",
    "test:fnd-05.5": "node --import tsx --test test/foundation/healthEndpoints.integration.test.ts",
    "test:fnd-05.4": "node --import tsx --test test/foundation/healthProbes.unit.test.ts",
    "test:fnd-05.6": "node --import tsx --test test/foundation/lifecycle.unit.test.ts",
    "test:fnd-05.1": "node --import tsx --test test/foundation/runtimeConfig.unit.test.ts",
    "test:fnd-02": "node --import tsx test/test-fnd02-domain-contracts.ts",
    "test:fnd-06": "node --import tsx --test test/baseline/*.test.ts",
    "test:baseline": "node --import tsx --test test/baseline/*.test.ts",
    "test:fnd-07": "node --import tsx --test test/architecture/*.test.ts",
    "test:agt-p0": "node --import tsx --test test/foundation/langgraphCheckpointSchema.unit.test.ts test/foundation/runtimeConfig.unit.test.ts",
    "test:agt-p0:db": "node --import tsx --test test/foundation/langgraphCheckpointSchema.integration.test.ts",
    "test:agt-01": "node --import tsx --test test/unit/agents/*.test.ts test/security/checkpointCredentials.test.ts",
    "test:agt-02": "node --import tsx --test test/unit/agents/runtime/*.test.ts test/security/checkpointPersistence.test.ts",
    "test:agt-02:db": "node --import tsx --test test/integration/agents/runLifecycle.integration.test.ts",
    "test:security": "node --import tsx --test test/security/*.test.ts",
    "check:architecture": "node --import tsx --test test/architecture/*.test.ts",
    "test:hybrid": "tsx test/test-hybrid-search.ts",
    "test:stream": "node --import tsx test/test-chat-streaming.ts",
    "start": "node dist/index.js",
    "start:legacy": "nodemon index.js",
    "test": "tsx test/test-setup.js",
    "test:foundation": "node --import tsx --test --test-concurrency=1 test/foundation/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "axios": "^1.16.1",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^170.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.11",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
