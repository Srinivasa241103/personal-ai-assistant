# =============================================================================
# MyRA backend — environment template (FND-05.2)
# =============================================================================
# Getting started:
#
#     cp .env.example .env          # then fill in the (secret) blanks
#     npm run services:up           # starts postgres/chroma/redis (docker)
#     npm run migrate               # applies database migrations
#     npm run dev                   # starts the backend
#
# Defaults below match docker-compose.dev.yml at the repo root — the compose
# services listen on non-standard ports (55432/58000/56379) precisely so they
# never collide with anything you already run locally.
#
# Lines marked (secret) are intentionally blank. Never commit real values;
# .env is gitignored, this template is not. Startup validation
# (src/config/runtimeConfig.ts) reports every missing/invalid variable at once
# and never prints a secret value.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=2020
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (required — the one hard dependency at every stage)
# -----------------------------------------------------------------------------
# These credentials match the docker-compose.dev.yml defaults. If you point at
# any database other than the local dev container, change them together with
# the compose overrides (MYRA_V2_PG_USER / MYRA_V2_PG_PASSWORD / MYRA_V2_PG_DB)
# — and never reuse the local-only password anywhere real.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=myra_v2
DB_USER=myra
DB_PASSWORD=myra_v2_local_dev
DB_SSL=false
DB_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# "chroma" (local container, the dev/test default) or "pgvector".
VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=58000
CHROMA_SSL=false
CHROMA_COLLECTION=myra_chunks_v1
# Chroma Cloud only — leave blank for the local container. Setting an API key
# selects cloud mode, which then also requires tenant + database.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# To populate a fresh local Chroma from Postgres (no re-embedding):
#     npm run migrate:chroma

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:56379
# Redis is optional until TOL-03 (locks/queues); an unreachable Redis degrades
# readiness instead of failing it while this stays false.
REDIS_REQUIRED=false

# -----------------------------------------------------------------------------
# Auth (secret)
# -----------------------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
# Migrations on boot: "auto" applies pending migrations, "verify" only reports
# drift. Unset = auto in development, verify everywhere else ("auto" is
# rejected outright in production). Uncomment to override:
# MIGRATIONS_ON_BOOT=verify
READINESS_PROBE_TIMEOUT_MS=2000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
# Keep crons off until Google OAuth credentials below are configured; the sync
# crons call Google APIs and will only log errors without them.
ENABLE_CRON_JOBS=false

# -----------------------------------------------------------------------------
# Agent runtime (AGT-01…AGT-07) — off by default
# -----------------------------------------------------------------------------
# While false, the V1 chat path is the only behaviour this backend serves: the
# agent-run endpoints are not mounted and no graph is compiled. Turn it on only
# on a machine where you intend to exercise the LangGraph runtime.
AGENT_RUNTIME_ENABLED=false

# LangGraph checkpointing. The schema is created by migration
# 0003_agt_02_langgraph_checkpoints.sql, not by the library's setup(); change
# this only if you also add a migration that creates the new schema.
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph
# Ceiling on one serialized checkpoint. Large tool results belong in
# evidence_items and are referenced by ID, never carried in graph state.
AGENT_MAX_CHECKPOINT_BYTES=262144

# Run budgets (master plan §9.4). Every one of these is a bound the graph
# enforces; a run that reaches any of them terminates with a partial result
# rather than continuing.
AGENT_MAX_STEPS=40
AGENT_MAX_RETRIES=2
AGENT_MAX_DURATION_MS=90000
AGENT_MAX_TOKENS=120000
AGENT_MAX_COST_USD=1
AGENT_MAX_PARALLEL_WORKERS=4
AGENT_MAX_EXTERNAL_ACTIONS=3

# Loop bounds. These are ceilings, not starting values — validation rejects a
# larger number. Lowering them is allowed.
AGENT_MAX_REPLAN_ITERATIONS=3
AGENT_MAX_VERIFICATION_RETRIES=2

# How long a pending clarification or approval stays answerable. An expired
# approval can never execute; the user is asked again.
AGENT_CLARIFICATION_TTL_MS=900000
AGENT_APPROVAL_TTL_MS=900000

# Model tiers — "cheap, mid, strong". Pinned per run in traces and evaluation
# records. The provider selects which API key below is used.
AGENT_MODEL_PROVIDER=anthropic
AGENT_MODEL_CHEAP=claude-haiku-4-5-20251001
AGENT_MODEL_MID=claude-sonnet-5
AGENT_MODEL_STRONG=claude-opus-5

# Tool Gateway (TOL-01/TOL-02). The timeout is the per-call default; individual
# tool definitions may specify a shorter one. Results larger than the byte limit
# are truncated before any model sees them.
TOOL_DEFAULT_TIMEOUT_MS=15000
TOOL_MAX_RESULT_BYTES=131072

# =============================================================================
# V1 application keys — read directly by the existing runtime, not yet
# validated by runtimeConfig. Fill in what you use; blanks fall back to
# in-code defaults where they exist.
# =============================================================================

# --- LLM providers (secret keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_MODEL_TEMP=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_MONTHLY_BUDGET=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=
CLAUDE_TEMPERATURE=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_PLANNER_MODEL=
OPENAI_LIGHT_MODEL=
OPENAI_MODEL_TEMP=
OPENAI_MAX_TOKENS=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_TEMPERATURE=
GEMINI_TOP_K=
GEMINI_TOP_P=

# --- Embeddings ---
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# --- Google OAuth (Gmail/Calendar sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REDIRECT_URI_PROD=
SYNC_USER_ID=

# --- Mail alerts (SMTP) ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_ALERT_RECIPIENT=

# --- Cron schedules & toggles ---
CRON_TIMEZONE=
ENABLE_EMBEDDING_CRON=false
EMBEDDING_CRON_SCHEDULE=
ENABLE_GMAIL_SYNC_CRON=false
GMAIL_SYNC_CRON_SCHEDULE=
ENABLE_CREDS_ALERT_CRON=false
CREDS_ALERT_CRON_SCHEDULE=
ENABLE_API_BUDGET_ALERT_CRON=false
API_BUDGET_ALERT_CRON_SCHEDULE=

# --- Misc / legacy ---
FRONTEND_URL_PROD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Checkpoint credential-shape test fixtures (optional) ---
# Only set these in .env when you need to override the generated safe fixtures.
# Keep this template as placeholders so repository secret scanning stays clean.
CHECKPOINT_TEST_GOOGLE_ACCESS_TOKEN=<checkpoint-test-google-access-token>
CHECKPOINT_TEST_GOOGLE_REFRESH_TOKEN=<checkpoint-test-google-refresh-token>
CHECKPOINT_TEST_GOOGLE_API_KEY=<checkpoint-test-google-api-key>
CHECKPOINT_TEST_OPENAI_API_KEY=<checkpoint-test-openai-api-key>
CHECKPOINT_TEST_ANTHROPIC_API_KEY=<checkpoint-test-anthropic-api-key>
CHECKPOINT_TEST_SLACK_TOKEN=<checkpoint-test-slack-token>
CHECKPOINT_TEST_BEARER_HEADER=<checkpoint-test-bearer-header>
CHECKPOINT_TEST_PEM_PRIVATE_KEY=<checkpoint-test-pem-private-key>
CHECKPOINT_TEST_SMUGGLED_GOOGLE_ACCESS_TOKEN=<checkpoint-test-smuggled-google-access-token>
